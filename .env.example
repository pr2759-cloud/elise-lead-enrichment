# Required for NewsAPI enrichment (free tier: 100 requests/day)
# Get a key at https://newsapi.org/register
NEWSAPI_KEY=

# Required for WalkScore enrichment (free tier: 5,000 calls/day)
# Get a key at https://www.walkscore.com/professional/api-sign-up.php
WALKSCORE_KEY=

# Optional - US Census works without a key for light usage
# Get a key at https://api.census.gov/data/key_signup.html
CENSUS_KEY=

# Optional - enable LLM-polished outreach emails (Claude Haiku)
# Without this the tool uses pure template-based emails (still works fine)
ANTHROPIC_API_KEY=

# Google Sheets integration (only needed for --sheet mode)
# Path to the service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Sheet to read leads from and write enriched results back to
LEADS_SHEET_ID=
LEADS_WORKSHEET_NAME=Leads

# Cache location (SQLite)
CACHE_PATH=./cache.db

# How verbose logging should be: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
